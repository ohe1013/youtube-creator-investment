generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Creator {
  id                String           @id @default(cuid())
  youtubeChannelId  String           @unique
  name              String
  thumbnailUrl      String?
  category          String?
  country           String?
  currentSubs       Float            @default(0)
  currentViews      Float            @default(0)
  currentVideos     Float            @default(0)
  currentScore      Float            @default(0)
  currentPrice      Decimal          @default(100) @db.Decimal(20, 4)
  isActive          Boolean          @default(true)
  visibility        Visibility       @default(PUBLIC)
  lastSyncedAt      DateTime         @updatedAt
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  circulatingSupply Decimal          @default(200000) @db.Decimal(20, 8)
  initialPrice      Decimal          @default(100) @db.Decimal(20, 4)
  liquidity         Decimal          @default(10000) @db.Decimal(20, 4)
  reserveSupply     Decimal          @default(800000) @db.Decimal(20, 8)
  totalSupply       Decimal          @default(1000000) @db.Decimal(20, 8)
  stats             CreatorStat[]
  positions         Position[]
  legacyTrades      LegacyTrade[]
  tradeExecutions   TradeExecution[]
  videos            Video[]

  // Aggregated Content Stats (Managed by Cron)
  avgLikes       Float   @default(0)
  avgComments    Float   @default(0)
  engagementRate Float   @default(0)
  viewsPerSubs   Float   @default(0)
  Order          Order[]

  @@index([youtubeChannelId])
  @@index([category])
  @@index([visibility, isActive])
}

model CreatorStat {
  id               String   @id @default(cuid())
  creatorId        String
  date             DateTime
  period           Period   @default(DAILY)
  subs             Float
  views            Float
  videos           Float
  dailySubsChange  Float    @default(0)
  dailyViewsChange Float    @default(0)

  // Engagement History
  avgLikes      Float @default(0)
  avgComments   Float @default(0)
  totalLikes    Float @default(0)
  totalComments Float @default(0)

  createdAt DateTime @default(now())

  creator Creator @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@unique([creatorId, date, period])
  @@index([creatorId, date])
}

model Video {
  id           String    @id // YouTube Video ID
  creatorId    String
  title        String
  thumbnailUrl String?
  publishedAt  DateTime
  duration     String // ISO 8601 (e.g., PT1M5S)
  type         VideoType @default(LONG)

  // Latest Stats
  viewCount    Float @default(0)
  likeCount    Float @default(0)
  commentCount Float @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  creator Creator @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@index([creatorId, publishedAt])
  @@index([type])
}

model User {
  id                 String              @id @default(cuid())
  name               String?
  email              String?             @unique
  emailVerified      DateTime?
  image              String?
  role               UserRole            @default(USER)
  initialBudget      Decimal             @default(100000) @db.Decimal(20, 4)
  balance            Decimal             @default(100000) @db.Decimal(20, 4)
  reservedBalance    Decimal             @default(0) @db.Decimal(20, 4)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  isBot              Boolean             @default(false)
  accounts           Account[]
  positions          Position[]
  sessions           Session[]
  legacyTrades       LegacyTrade[]
  orders             Order[]
  identities         AuthIdentity[]
  appSessions        AppSession[]
  idempotencyRecords IdempotencyRecord[]
  boughtExecutions   TradeExecution[]    @relation("ExecutionBuyer")
  soldExecutions     TradeExecution[]    @relation("ExecutionSeller")
}

model Position {
  id               String   @id @default(cuid())
  userId           String
  creatorId        String
  quantity         Decimal  @db.Decimal(20, 8)
  reservedQuantity Decimal  @default(0) @db.Decimal(20, 8)
  avgPrice         Decimal  @db.Decimal(20, 4)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  creator          Creator  @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, creatorId])
  @@index([userId])
}

model LegacyTrade {
  id        String    @id @default(cuid())
  userId    String
  creatorId String
  orderId   String? // Link to the Order that generated this trade (if any)
  type      TradeType
  quantity  Decimal   @db.Decimal(20, 8)
  price     Decimal   @db.Decimal(20, 4)
  createdAt DateTime  @default(now())
  creator   Creator   @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  order     Order?    @relation(fields: [orderId], references: [id])

  @@index([userId, createdAt])
  @@index([creatorId])
  @@index([orderId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum Visibility {
  PUBLIC
  HIDDEN
}

enum VideoType {
  LONG
  SHORTS
}

enum Period {
  HOURLY
  DAILY
}

enum UserRole {
  USER
  ADMIN
}

enum TradeType {
  BUY
  SELL
}

enum IdentityProvider {
  GUEST
  TOSS
}

enum OrderType {
  LIMIT
  MARKET
}

enum OrderStatus {
  OPEN
  PARTIAL
  FILLED
  CANCELLED
}

model Order {
  id               String      @id @default(cuid())
  userId           String
  creatorId        String
  type             TradeType // BUY or SELL side
  orderType        OrderType   @default(LIMIT)
  price            Decimal     @db.Decimal(20, 4) // Limit Price
  quantity         Decimal     @db.Decimal(20, 8) // Original Quantity
  filled           Decimal     @default(0) @db.Decimal(20, 8) // Filled Quantity
  reservedQuote    Decimal     @default(0) @db.Decimal(20, 4)
  reservedQuantity Decimal     @default(0) @db.Decimal(20, 8)
  status           OrderStatus @default(OPEN)
  completedAt      DateTime?
  cancelReason     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  creator         Creator          @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  legacyTrades    LegacyTrade[]
  makerExecutions TradeExecution[] @relation("MakerOrderExecution")
  takerExecutions TradeExecution[] @relation("TakerOrderExecution")

  @@index([creatorId, status, type, price]) // For matching engine (Price-Time priority)
  @@index([userId])
}

model AuthIdentity {
  id        String           @id @default(cuid())
  provider  IdentityProvider
  subject   String
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions  AppSession[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@unique([provider, subject])
  @@index([userId])
}

model AppSession {
  id               String       @id @default(cuid())
  userId           String
  identityId       String
  refreshFamilyId  String
  refreshTokenHash String       @unique
  expiresAt        DateTime
  revokedAt        DateTime?
  replacedById     String?      @unique
  lastUsedAt       DateTime?
  createdAt        DateTime     @default(now())
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  identity         AuthIdentity @relation(fields: [identityId], references: [id], onDelete: Cascade)
  replacedBy       AppSession?  @relation("SessionReplacement", fields: [replacedById], references: [id], onDelete: SetNull)
  replaces         AppSession?  @relation("SessionReplacement")

  @@index([userId])
  @@index([identityId])
  @@index([refreshFamilyId])
  @@index([expiresAt])
}

model IdempotencyRecord {
  id             String   @id @default(cuid())
  userId         String
  operation      String
  key            String
  requestHash    String
  state          String
  responseStatus Int?
  responseBody   Json?
  expiresAt      DateTime
  createdAt      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, operation, key])
  @@index([expiresAt])
}

model TradeExecution {
  id           String   @id @default(cuid())
  makerOrderId String
  takerOrderId String
  buyerId      String
  sellerId     String
  creatorId    String
  price        Decimal  @db.Decimal(20, 4)
  quantity     Decimal  @db.Decimal(20, 8)
  quoteAmount  Decimal  @db.Decimal(20, 4)
  executedAt   DateTime @default(now())
  makerOrder   Order    @relation("MakerOrderExecution", fields: [makerOrderId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  takerOrder   Order    @relation("TakerOrderExecution", fields: [takerOrderId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  buyer        User     @relation("ExecutionBuyer", fields: [buyerId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  seller       User     @relation("ExecutionSeller", fields: [sellerId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  creator      Creator  @relation(fields: [creatorId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([makerOrderId])
  @@index([takerOrderId])
  @@index([buyerId, executedAt])
  @@index([sellerId, executedAt])
  @@index([creatorId, executedAt])
}

model RateLimitBucket {
  keyHash   String   @id
  count     Int      @default(0)
  expiresAt DateTime
  updatedAt DateTime @updatedAt

  @@index([expiresAt])
}
