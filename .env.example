NEXT_PUBLIC_APP_IN_TOSS=1
NEXT_PUBLIC_CREATORX_RELEASE_CHANNEL=sandbox
NEXT_PUBLIC_CREATORX_DATA_MODE=demo
NEXT_PUBLIC_CREATORX_API_BASE_URL=
NEXT_PUBLIC_CREATORX_OPERATOR_NAME=CreatorX 개발팀
NEXT_PUBLIC_CREATORX_SUPPORT_URL=https://github.com/ohe1013/youtube-creator-investment/issues
NEXT_PUBLIC_CREATORX_PRIVACY_CONTACT=GitHub Issues
NEXT_PUBLIC_CREATORX_LEGAL_EFFECTIVE_DATE=2026-07-10
NEXT_PUBLIC_CREATORX_ICON_URL=

# Backend database and server-only secrets
# Use .env.test.example as the template for the isolated local test database.
DATABASE_URL=
DIRECT_URL=
CREATORX_ACCESS_TOKEN_SECRET=
CREATORX_IDENTITY_PEPPER=
CRON_SECRET=
# Comma-separated exact local origins only. Leave empty in production.
CREATORX_DEV_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:5173
# Set to 1 only when a trusted reverse proxy overwrites x-forwarded-proto.
CREATORX_TRUST_PROXY=0
